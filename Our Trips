<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>رحلة الشفاء | التسجيل للسفر العلاجي</title>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=Amiri:wght@700&display=swap" rel="stylesheet">
<style>
:root{
  --gold:#d4af37;
  --gold-light:#f0d98c;
  --dark:#0a0e1a;
  --dark2:#101830;
  --glass:rgba(255,255,255,.06);
  --border:rgba(212,175,55,.35);
}
*{margin:0;padding:0;box-sizing:border-box;font-family:'Tajawal',sans-serif}
html{scroll-behavior:smooth}
body{background:var(--dark);color:#fff;overflow-x:hidden}

/* ===== خلفية فخمة متحركة ===== */
#bgCanvas{position:fixed;inset:0;z-index:-2}
.glow{position:fixed;border-radius:50%;filter:blur(120px);z-index:-1;opacity:.35;animation:float 12s ease-in-out infinite}
.glow.g1{width:500px;height:500px;background:#1a3a8f;top:-150px;right:-100px}
.glow.g2{width:450px;height:450px;background:#6b4fa0;bottom:-120px;left:-100px;animation-delay:4s}
.glow.g3{width:300px;height:300px;background:var(--gold);top:40%;left:35%;opacity:.12;animation-delay:8s}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(60px)}}

/* ===== الهيدر ===== */
header{position:fixed;top:0;right:0;left:0;z-index:100;padding:18px 6%;display:flex;justify-content:space-between;align-items:center;backdrop-filter:blur(14px);background:rgba(10,14,26,.7);border-bottom:1px solid var(--border)}
.logo{display:flex;align-items:center;gap:12px;font-size:26px;font-weight:900;color:var(--gold)}
.logo svg{width:38px;height:38px}
nav a{color:#cfd8ea;text-decoration:none;margin:0 14px;font-weight:500;font-size:17px;transition:.3s;position:relative}
nav a:hover{color:var(--gold-light)}
nav a::after{content:'';position:absolute;bottom:-6px;right:0;width:0;height:2px;background:linear-gradient(90deg,var(--gold),var(--gold-light));transition:.3s}
nav a:hover::after{width:100%}
.btn-gold{background:linear-gradient(135deg,var(--gold),#b8932a);color:#0a0e1a!important;padding:10px 26px;border-radius:30px;font-weight:800!important}
.btn-gold::after{display:none}

/* ===== البطل ===== */
.hero{min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:120px 6% 60px;position:relative}
.hero .badge{display:inline-block;padding:8px 22px;border:1px solid var(--border);border-radius:30px;color:var(--gold-light);font-size:15px;margin-bottom:24px;background:var(--glass);backdrop-filter:blur(8px)}
.hero h1{font-size:clamp(38px,6.5vw,74px);font-weight:900;line-height:1.35;background:linear-gradient(135deg,#fff 30%,var(--gold-light) 70%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.hero p{max-width:650px;margin:22px auto 36px;color:#b9c4d8;font-size:19px;line-height:1.9}
.hero .btns{display:flex;gap:16px;flex-wrap:wrap;justify-content:center}
.btn{padding:15px 42px;border-radius:40px;font-size:18px;font-weight:800;text-decoration:none;transition:.35s;cursor:pointer;border:none;display:inline-block}
.btn-gold2{background:linear-gradient(135deg,var(--gold),#a8842a);color:#0a0e1a;box-shadow:0 8px 30px rgba(212,175,55,.35)}
.btn-gold2:hover{transform:translateY(-4px);box-shadow:0 14px 40px rgba(212,175,55,.5)}
.btn-outline{border:1.5px solid var(--border);color:var(--gold-light);background:var(--glass)}
.btn-outline:hover{background:rgba(212,175,55,.15);transform:translateY(-4px)}
.stats{display:flex;gap:40px;margin-top:70px;flex-wrap:wrap;justify-content:center}
.stat{text-align:center}
.stat b{font-size:40px;color:var(--gold);display:block}
.stat span{color:#8d99b0;font-size:15px}

/* ===== الأقسام ===== */
section{padding:100px 6%}
.sec-title{text-align:center;margin-bottom:60px}
.sec-title h2{font-size:38px;font-weight:900;color:#fff}
.sec-title h2 em{font-style:normal;color:var(--gold)}
.sec-title .line{width:80px;height:3px;background:linear-gradient(90deg,transparent,var(--gold),transparent);margin:16px auto 0}

/* من نحن */
.about{display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center;max-width:1200px;margin:0 auto}
.about .text h3{font-size:28px;margin-bottom:18px;color:var(--gold-light)}
.about .text p{color:#b9c4d8;line-height:2;font-size:17px;margin-bottom:16px}
.about .img-box{position:relative;border-radius:24px;overflow:hidden;border:1px solid var(--border);box-shadow:0 20px 60px rgba(0,0,0,.5)}
.about .img-box::before{content:'';position:absolute;inset:0;background:linear-gradient(160deg,rgba(212,175,55,.25),transparent 55%);z-index:1}
.about .img-box div{height:380px;background:radial-gradient(circle at 30% 30%,#24356b,#0d1330 70%);display:flex;align-items:center;justify-content:center;font-size:90px}

/* البطاقات */
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:26px;max-width:1200px;margin:0 auto}
.card{background:var(--glass);border:1px solid var(--border);border-radius:20px;padding:36px 28px;backdrop-filter:blur(10px);transition:.4s;position:relative;overflow:hidden}
.card::before{content:'';position:absolute;top:0;right:0;left:0;height:3px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0;transition:.4s}
.card:hover{transform:translateY(-10px);background:rgba(255,255,255,.09);box-shadow:0 20px 50px rgba(0,0,0,.45)}
.card:hover::before{opacity:1}
.card .icon{width:64px;height:64px;border-radius:16px;display:flex;align-items:center;justify-content:center;background:rgba(212,175,55,.15);margin-bottom:20px}
.card .icon svg{width:32px;height:32px;stroke:var(--gold)}
.card h3{font-size:21px;margin-bottom:12px;color:#fff}
.card p{color:#9aa7bf;line-height:1.9;font-size:15px}

/* نموذج تسجيل الدخول */
.login-wrap{max-width:460px;margin:0 auto;background:var(--glass);border:1px solid var(--border);border-radius:26px;padding:46px 40px;backdrop-filter:blur(16px);box-shadow:0 25px 70px rgba(0,0,0,.55)}
.login-wrap h3{text-align:center;font-size:26px;margin-bottom:6px;color:var(--gold-light)}
.login-wrap>p{text-align:center;color:#8d99b0;font-size:14px;margin-bottom:30px}
.field{margin-bottom:20px}
.field label{display:block;margin-bottom:8px;font-size:15px;color:#cfd8ea}
.field input{width:100%;padding:14px 18px;border-radius:12px;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.05);color:#fff;font-size:16px;outline:none;transition:.3s}
.field input:focus{border-color:var(--gold);box-shadow:0 0 0 4px rgba(212,175,55,.15)}
.login-wrap .btn{width:100%;margin-top:8px}
.login-msg{text-align:center;margin-top:16px;font-size:15px;min-height:22px}
.login-msg.ok{color:#5eead4}
.login-msg.err{color:#f87171}
.note{text-align:center;margin-top:22px;padding-top:20px;border-top:1px dashed rgba(255,255,255,.15);color:#8d99b0;font-size:14px}

/* تواصل */
.contact-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:24px;max-width:1000px;margin:0 auto}
.contact-item{text-align:center;padding:34px 20px;background:var(--glass);border:1px solid var(--border);border-radius:18px;transition:.3s}
.contact-item:hover{transform:translateY(-6px)}
.contact-item .c-icon{font-size:36px;margin-bottom:14px}
.contact-item b{display:block;color:var(--gold-light);margin-bottom:6px;font-size:18px}
.contact-item span{color:#9aa7bf;font-size:15px;direction:ltr;display:inline-block}

footer{text-align:center;padding:36px 6%;border-top:1px solid var(--border);color:#8d99b0;font-size:15px;background:rgba(0,0,0,.3)}
footer b{color:var(--gold)}

@media(max-width:820px){
  nav{display:none}
  .about{grid-template-columns:1fr}
  section{padding:70px 6%}
}
</style>
</head>
<body>

<canvas id="bgCanvas"></canvas>
<div class="glow g1"></div><div class="glow g2"></div><div class="glow g3"></div>

<header>
  <div class="logo">
    <svg viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="2"><path d="M12 21s-7-4.5-9.5-9C.5 8 3 4.5 6.5 4.5c2 0 3.7 1.2 5.5 3.5 1.8-2.3 3.5-3.5 5.5-3.5C21 4.5 23.5 8 21.5 12 19 16.5 12 21 12 21z"/></svg>
    رحلة الشفاء
  </div>
  <nav>
    <a href="#home">الرئيسية</a>
    <a href="#about">من نحن</a>
    <a href="#sections">أقسامنا</a>
    <a href="#login">تسجيل الدخول</a>
    <a href="#contact">تواصل معنا</a>
    <a href="#login" class="btn-gold">دخول</a>
  </nav>
</header>

<!-- البطل -->
<div class="hero" id="home">
  <span class="badge">✦ منصة السفر العلاجي الأولى ✦</span>
  <h1>سافر للعلاج بأمان وراحة<br>نحن معك في كل خطوة</h1>
  <p>منصة متكاملة لتسجيل المرضى والمرافقين للسفر العلاجي، مع متابعة كاملة لرحلتك العلاجية من التسجيل حتى العودة بإذن الله.</p>
  <div class="btns">
    <a href="#login" class="btn btn-gold2">تسجيل الدخول</a>
    <a href="#sections" class="btn btn-outline">تعرّف على أقسامنا</a>
  </div>
  <div class="stats">
    <div class="stat"><b>+5000</b><span>مريض تمت خدمته</span></div>
    <div class="stat"><b>+12</b><span>دولة علاجية</span></div>
    <div class="stat"><b>98%</b><span>نسبة رضا المرضى</span></div>
  </div>
</div>

<!-- من نحن -->
<section id="about">
  <div class="sec-title"><h2><em>من</em> نحن</h2><div class="line"></div></div>
  <div class="about">
    <div class="text">
      <h3>رفيقك الموثوق في رحلة العلاج</h3>
      <p>«رحلة الشفاء» منصة إنسانية متخصصة في تنظيم السفر العلاجي للمرضى ومرافقيهم. نؤمن بأن كل مريض يستحق رحلة علاجية مرتبة بعناية، بعيداً عن التعب والتفاصيل المعقدة.</p>
      <p>نسّقنا مئات الرحلات العلاجية إلى أفضل المستشفيات والمراكز العلاجية في العالم، مع فريق متابعة يصطحبك خطوة بخطوة، من التأشيرة والحجز الطبي وحتى الإقامة والترجمة الطبية.</p>
      <p>هذه المنصة مخصصة للتسجيل والمتابعة. الدخول للمنصة يتم عبر الحسابات المعتمدة الصادرة من الإدارة فقط.</p>
    </div>
    <div class="img-box"><div>🌍✈️</div></div>
  </div>
</section>

<!-- الأقسام -->
<section id="sections">
  <div class="sec-title"><h2><em>أقسام</em>نا</h2><div class="line"></div></div>
  <div class="cards">
    <div class="card">
      <div class="icon"><svg fill="none" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2L2 7v10l10 5 10-5V7L12 2z"/><path d="M12 22V12M2 7l10 5 10-5"/></svg></div>
      <h3>قسم تسجيل المرضى</h3>
      <p>تسجيل بيانات المريض وملفه العلاجي ومتابعة حالة الطلب خطوة بخطوة حتى اعتماد السفر.</p>
    </div>
    <div class="card">
      <div class="icon"><svg fill="none" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg></div>
      <h3>قسم المرافقين</h3>
      <p>إضافة المرافقين للمريض وربط حساباتهم بحالة السفر مع إشعارات مستمرة بكل المستجدات.</p>
    </div>
    <div class="card">
      <div class="icon"><svg fill="none" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></div>
      <h3>حجز المواعيد</h3>
      <p>جدولة مواعيد المستشفيات والفحوصات والاستشارات الطبية قبل السفر وبعده بسهولة.</p>
    </div>
    <div class="card">
      <div class="icon"><svg fill="none" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
      <h3>متابعة الرحلة</h3>
      <p>تتبع مباشر لحالة الطلب: التأشيرة، تذاكر السفر، الإقامة، وجدول العلاج في الخارج.</p>
    </div>
  </div>
</section>

<!-- تسجيل الدخول -->
<section id="login">
  <div class="sec-title"><h2>تسجيل <em>الدخول</em></h2><div class="line"></div></div>
  <div class="login-wrap">
    <h3>مرحباً بعودتك 👋</h3>
    <p>الدخول متاح للحسابات المعتمدة فقط</p>
    <form id="loginForm">
      <div class="field">
        <label>رقم الهوية / اسم المستخدم</label>
        <input type="text" id="username" placeholder="أدخل رقم الهوية أو اسم المستخدم" required>
      </div>
      <div class="field">
        <label>كلمة المرور</label>
        <input type="password" id="password" placeholder="••••••••" required>
      </div>
      <button type="submit" class="btn btn-gold2">دخول</button>
      <div class="login-msg" id="loginMsg"></div>
    </form>
    <div class="note">🔒 إنشاء الحسابات يتم من إدارة المنصة فقط — تواصل معنا للحصول على حسابك</div>
  </div>
</section>

<!-- تواصل -->
<section id="contact">
  <div class="sec-title"><h2>تواصل <em>معنا</em></h2><div class="line"></div></div>
  <div class="contact-grid">
    <div class="contact-item"><div class="c-icon">📞</div><b>الهاتف</b><span>+963 900 000 000</span></div>
    <div class="contact-item"><div class="c-icon">✉️</div><b>البريد الإلكتروني</b><span>info@ra7a-shifa.com</span></div>
    <div class="contact-item"><div class="c-icon">💬</div><b>واتساب</b><span>+963 900 000 000</span></div>
    <div class="contact-item"><div class="c-icon">📍</div><b>العنوان</b><span>دمشق، سوريا</span></div>
  </div>
</section>

<footer>جميع الحقوق محفوظة © 2026 — <b>رحلة الشفاء</b> | منصة السفر العلاجي للمرضى والمرافقين</footer>

<script>
// خلفية الجسيمات المتحركة
const c = document.getElementById('bgCanvas'), ctx = c.getContext('2d');
let W, H, parts = [];
function resize(){ W = c.width = innerWidth; H = c.height = innerHeight; }
resize(); addEventListener('resize', resize);
for(let i=0;i<80;i++) parts.push({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:Math.random()*2+.5,vx:(Math.random()-.5)*.4,vy:(Math.random()-.5)*.4,o:Math.random()*.5+.15});
(function anim(){
  ctx.clearRect(0,0,W,H);
  parts.forEach(p=>{
    p.x+=p.vx; p.y+=p.vy;
    if(p.x<0)p.x=W; if(p.x>W)p.x=0; if(p.y<0)p.y=H; if(p.y>H)p.y=0;
    ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,7);
    ctx.fillStyle=`rgba(212,175,55,${p.o})`; ctx.fill();
  });
  requestAnimationFrame(anim);
})();

// تسجيل الدخول (تجريبي)
document.getElementById('loginForm').addEventListener('submit', function(e){
  e.preventDefault();
  const u = document.getElementById('username').value.trim();
  const p = document.getElementById('password').value.trim();
  const msg = document.getElementById('loginMsg');
  if(!u || !p){ msg.textContent = '⚠️ يرجى تعبئة جميع الحقول'; msg.className='login-msg err'; return; }
  if(u === 'admin' && p === '123456'){
    msg.textContent = '✅ تم تسجيل الدخول بنجاح، أهلاً بك!'; msg.className='login-msg ok';
  } else {
    msg.textContent = '❌ بيانات الدخول غير صحيحة أو الحساب غير معتمد'; msg.className='login-msg err';
  }
});
</script>
</body>
</html>
